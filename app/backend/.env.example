# Lokale Entwicklung: docker compose up (siehe README), dann npm run dev
PORT=8080
PGHOST=localhost
PGPORT=5432
PGDATABASE=askit
PGUSER=askit
PGPASSWORD=askit
DB_SSL=disable
# Issuer = was im Token steht (Browser-Sicht über den Vite-Proxy), JWKS direkt vom Container
OIDC_ISSUER=http://localhost:5173/auth/realms/askit
OIDC_JWKS_URL=http://localhost:8081/auth/realms/askit/protocol/openid-connect/certs
OIDC_CLIENT_ID=askit-frontend
# Optional – ohne diese Werte sind die Features einfach aus:
# S3_ENDPOINT=https://object.storage.eu01.onstackit.cloud
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AI_API_KEY=
# AI_MODEL=
